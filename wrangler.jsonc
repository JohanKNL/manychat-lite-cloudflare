{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "manychat-lite-cloudflare",
	"main": "src/index.ts",
	"compatibility_date": "2026-06-30",
	"compatibility_flags": [
		"nodejs_compat"
	],
	// Daily Instagram connection check and token renewal (skipped while DRY_RUN is "true").
	"triggers": {
		"crons": ["0 6 * * *"]
	},
	"workers_dev": true,
	"preview_urls": false,
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"vars": {
		"GRAPH_API_BASE": "https://graph.facebook.com/v25.0",
		"KEYWORD": "",
		"PRIVATE_REPLY_TEXT": "Thanks for commenting. Here is the link: https://example.com",
		"CAPTION_LINK_HOST": "keukenliefde.nl",
		"RETENTION_DAYS": "30",
		"DRY_RUN": "true"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "manychat-lite-cloudflare",
			"database_id": "95e6d105-d803-4f32-80fb-83e192a70898",
			"migrations_dir": "./migrations"
		}
	]
}
